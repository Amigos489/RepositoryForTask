<?xml version='1.0' encoding='utf-8'?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
  <session-factory>
    <property name="hibernate.connection.driver_class">org.postgresql.Driver</property>
    <property name="hibernate.connection.url">jdbc:postgresql://localhost/book-store-hibernate</property>
    <property name="hibernate.connection.username">postgres</property>
    <property name="hibernate.connection.password">balabol</property>
    <property name="hibernate.show_sql">true</property>

    <mapping class="entitys.BookEntity"/>
    <mapping class="entitys.OrderEntity"/>
    <mapping class="entitys.RequestEntity"/>
  </session-factory>
</hibernate-configuration>